      "source": [
        "from dataclasses import dataclass\n",
        "\n",
        "class Student:\n",
        "    def __init__(self, name, age):\n",
        "        self.name, self.age = name, age\n",
        "\n",
        "@dataclass\n",
        "class StudentData:\n",
        "    name: str\n",
        "    age: int\n",
        "\n",
        "s1 = Student(\"Hunny\", 21)\n",
        "s2 = StudentData(\"Hunny\", 21)\n",
        "\n",
        "print(s1.name, s1.age)\n",
        "print(s2)"
      ]
    }
  ]
}